<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <false/>
  <key>com.apple.developer.system-extension.install</key>
  <true/>
  <!-- No DriverKit user-client entitlement here on purpose: the dext carries
       com.apple.developer.driverkit.allow-any-userclient-access (granted on
       its App ID). Upstream's ad-hoc build instead lists the dext in
       com.apple.developer.driverkit.userclient-access on the app:
         [ <prefix>.ASFW.ASFWDriver, <prefix>.ASFW.ASFWDriver:ASFWDriverUserClient ] -->
</dict>
</plist>
